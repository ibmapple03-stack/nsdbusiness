# Copy to .env for local development. Every value is optional:
# without them the site works, and locally the enquiry forms print
# messages to the terminal instead of emailing them.

# Public address of the site (used for search engines and social previews).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"   # production: https://www.nsdbusinessltd.com

# Enquiry form email. In production the forms appear only when
# EMAIL_DRIVER=resend, RESEND_API_KEY and FORM_SECRET are all set.
EMAIL_DRIVER="console"                          # console | resend
RESEND_API_KEY=""
EMAIL_FROM="NSD Business Academy <no-reply@nsdbusinessltd.com>"
ENQUIRY_TO="info@nsdbusinessltd.com"

# Random value used to sign form timing tokens: openssl rand -base64 32
FORM_SECRET=""

# NSD Business Academy — environment variables
# Copy to `.env` for local development. Never commit real values.
# In production, set these in the hosting provider's encrypted settings (e.g. Vercel → Project → Settings → Environment Variables).

# ── Database ────────────────────────────────────────────────
# Local: Postgres.app → postgresql://postgres@localhost:5432/nsd_dev
# Production: managed Postgres (Neon, Supabase, etc.) with sslmode=require
DATABASE_URL="postgresql://postgres@localhost:5432/nsd_dev"

# ── Authentication (Better Auth) ────────────────────────────
# Generate with: openssl rand -base64 32   (different value per environment)
BETTER_AUTH_SECRET=""
# The public base URL of this deployment
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"   # production: https://www.nsdbusinessltd.com

# Salt for one-way hashing of IP addresses in logs and rate limits.
# Generate with: openssl rand -hex 16
IP_HASH_SALT=""

# ── Email ───────────────────────────────────────────────────
# "console" prints emails to the server log (development only).
# "resend" sends real email — requires a verified sending domain.
EMAIL_DRIVER="console"
EMAIL_FROM="NSD Business Academy <no-reply@your-verified-domain>"
RESEND_API_KEY=""

# ── Safety switches (forced on/off in production regardless of value) ──
# Staff two-step sign-in. Always required in production.
REQUIRE_STAFF_MFA="true"
# Show draft page text and policies with "draft" markers. Always off in production.
CONTENT_PREVIEW="false"

# ── Development seed only ───────────────────────────────────
# Password for the fictional …@example.test demo staff accounts (12+ characters).
SEED_DEMO_PASSWORD=""
# "true" publishes FICTIONAL demo courses/cohorts for local review.
SEED_DEMO_CATALOGUE="false"

# ── Stage 2 (not used yet) ──────────────────────────────────
# PAYMENT_PROVIDER="paystack"
# PAYSTACK_SECRET_KEY=""        # sk_test_… in development; server-side only
# PAYSTACK_PUBLIC_KEY=""        # pk_test_…
# STORAGE_DRIVER="s3"
# S3_ENDPOINT="" S3_BUCKET="" S3_ACCESS_KEY_ID="" S3_SECRET_ACCESS_KEY=""

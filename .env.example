# Copy to .env for local development. Every value is optional.
# Locally, enquiry forms print messages to the terminal.

# Public address of the site (used for search engines and social previews).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"   # production: https://www.nsdbusinessltd.com

# Enquiry forms. Production default: formsubmit (no account; activate once from ENQUIRY_TO).
EMAIL_DRIVER="console"                          # console | formsubmit | resend
ENQUIRY_TO="info@nsdbusinessltd.com"
FORMSUBMIT_ALIAS=""                             # optional: random string FormSubmit sends after activation

# Optional: random value for stronger form spam protection (openssl rand -base64 32)
FORM_SECRET=""

# Only if EMAIL_DRIVER=resend
RESEND_API_KEY=""
EMAIL_FROM="NSD Business Academy <no-reply@nsdbusinessltd.com>"
